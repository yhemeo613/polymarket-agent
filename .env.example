# ================= 运行模式 =================
# paper-only（默认 true）。置 false 且提供 WALLET_PRIVATE_KEY 才会初始化实盘执行器
PAPER_ONLY=true
WALLET_PRIVATE_KEY=
# 实验预算（USD），paper 模式下为虚拟本金
BANKROLL_USD=500
# 孪生单（每笔 paper 信号同步 $1 真实单，度量 paper↔实盘成交偏差）。需 live 配置
TWIN_ORDERS=false

# ================= 存储 =================
DB_PATH=./data/agent.db
STRATEGY_DIR=./strategy
KILL_SWITCH_PATH=./data/kill.switch

# ================= LLM =================
# anthropic=开卷研究模式；none=baseline 模式（p̂=市场价，H0 基线，无 key 全链路可跑）
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
# 单次回复输出上限（非上下文窗口；模型上下文由服务端决定）
LLM_MAX_TOKENS=4096

# ================= 证据源（可选，无 key 自动降级为闭卷） =================
TAVILY_API_KEY=

# ================= Polymarket =================
GAMMA_HOST=https://gamma-api.polymarket.com
CLOB_HOST=https://clob.polymarket.com
POLYGON_CHAIN_ID=137
WS_ENABLED=false
# 出站代理（Gamma/CLOB 需代理可达时配置，如 http://127.0.0.1:7890）
PROXY_URL=

# ================= 调度 =================
# NestJS @Cron 六位（秒 分 时 日 月 周）：每小时第 7 分钟主循环
CYCLE_CRON=0 7 * * * *
# 每 15 分钟轻触发（持仓监控/止盈止损）
LIGHT_CRON=0 */15 * * * *
# 启动后 5 秒自动跑一轮主循环（立刻看到周期日志/验证管线）
CYCLE_RUN_ON_START=true

# ================= 扫描与预测 =================
SCAN_LIMIT=200
FORECAST_BATCH=12
SCREEN_TOP_K=8
MIN_LIQUIDITY=1000
MIN_VOLUME24H=5000
MIN_DAYS_TO_END=1
MAX_DAYS_TO_END=120
BLACKLIST_CATEGORIES=

# ================= 决策参数（硬帽在 risk 引擎，这里是软参数） =================
MIN_EDGE=0.02
SLIPPAGE_BUFFER_PCT=0.005
KELLY_FRACTION=0.25
TAKER_FEE_DEFAULT=0.07

# ================= 风控硬帽 =================
MAX_SINGLE_PCT=0.02
MAX_MARKET_PCT=0.05
MAX_TOTAL_PCT=0.5
MAX_POSITIONS=20
MAX_OPEN_PER_EVENT=3
DAILY_LOSS_HALT=0.05
DRAWDOWN_HALT=0.20

# ================= 持仓退出（确定性守护） =================
TAKE_PROFIT_AT=0.95
STOP_LOSS_AT=0.05

# ================= 告警（可选） =================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ================= 服务 =================
PORT=3000
LOG_LEVEL=info
