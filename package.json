{
  "name": "polymarket-agent",
  "version": "0.1.0",
  "description": "Fully autonomous AI prediction-market agent for Polymarket (paper-first, black-box experiment protocol built-in)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleDirectories": [
      "node_modules",
      "src"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/schedule": "^5.0.1",
    "@polymarket/clob-client": "^5.8.1",
    "axios": "^1.21.0",
    "chalk": "^4.1.2",
    "dayjs": "^1.11.23",
    "decimal.js": "^10.6.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "viem": "^2.57.17",
    "ws": "^8.22.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.9",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "jest": "^29.7.0",
    "pino-pretty": "^11.3.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
